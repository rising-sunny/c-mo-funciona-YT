  "equations": [
    {
      "start": 4,
      "end": 8,
      "expression": "p = F₁ / A₁",
      "definition": "Same added pressure throughout the fluid"
    },
    {
      "start": 8,
      "end": 12,
      "expression": "A₂ = 4·A₁",
      "definition": "Two times the radius → four times the area"
    },
    {
      "start": 12,
      "end": 14,
      "expression": "F₁/A₁ = F₂/A₂",
      "definition": "Pascal’s principle · ideal conditions"
    },
    {
      "start": 14,
      "end": 16,
      "expression": "F₂ = 4 × 10 = 40 N",
      "definition": "Force acts on the larger piston"
    },
    {
      "start": 16,
      "end": 19,
      "expression": "A₁·Δx₁ = A₂·Δx₂",
      "definition": "The displaced volumes must match"
    },
    {
      "start": 19,
      "end": 21,
      "expression": "80 mm in → 20 mm out",
      "definition": "More force, less distance"
    },
    {
      "start": 21,
      "end": 25,
      "expression": "10 × 0.08 = 40 × 0.02",
      "definition": "Ideal input work = output work = 0.8 J"
    }
  ],
