      },
      {
        "start": 3.65,
        "end": 6.8,
        "text": "Hold the button. Current flows through the coil.",
        "speed": 1.01
      },
      {
        "start": 7.15,
        "end": 10.8,
        "text": "The electromagnet pulls the armature and hammer.",
        "speed": 1.01
      },
      {
        "start": 11.15,
        "end": 14.8,
        "text": "But that movement opens this tiny contact!",
        "speed": 1.01
      },
      {
        "start": 15.15,
        "end": 18.8,
        "text": "The supply is cut. The magnetic pull fades.",
        "speed": 1.01
      },
      {
        "start": 19.15,
        "end": 22.8,
        "text": "The spring pulls back, closing the circuit again.",
        "speed": 1.01
      },
      {
        "start": 23.15,
        "end": 26.8,
        "text": "And it repeats while you hold the button.",
        "speed": 1.01
      },
      {
        "start": 27.12,
        "end": 29.85,
        "text": "Not free energy. The battery powers every ring.",
        "speed": 1.01
      }
